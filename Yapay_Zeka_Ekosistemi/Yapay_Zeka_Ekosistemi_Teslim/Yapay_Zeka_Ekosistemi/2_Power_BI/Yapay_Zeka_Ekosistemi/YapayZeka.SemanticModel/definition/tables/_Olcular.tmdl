table _Olcular

	column Sutun
		isHidden
		dataType: int64
		summarizeBy: none
		sourceColumn: Sutun

	measure 'Yatırım (Milyon $)' = ```
			DIVIDE(SUM(FactYatirim[YatirimUSD]), 1000000)
			```
		formatString: #,0.0
		displayFolder: 1 Yatırım

	measure 'Toplam Yatırım (Milyar $)' = ```
			DIVIDE(SUM(FactYatirim[YatirimUSD]), 1000000000)
			```
		formatString: #,0.0
		displayFolder: 1 Yatırım

	measure 'Yatırım Alan Ülke Sayısı' = ```
			DISTINCTCOUNT(FactYatirim[ISO3])
			```
		formatString: 0
		displayFolder: 1 Yatırım

	measure 'Yatırım Kaydı Olan Ülke Oranı' = ```
			DIVIDE([Yatırım Alan Ülke Sayısı], DISTINCTCOUNT(DimUlke[ISO3]))
			```
		formatString: 0%
		displayFolder: 1 Yatırım

	measure 'ABD Payı %' = ```
			DIVIDE(CALCULATE(SUM(FactYatirim[YatirimUSD]), REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "USA"), CALCULATE(SUM(FactYatirim[YatirimUSD]), REMOVEFILTERS(DimUlke)))
			```
		formatString: 0.0%
		displayFolder: 1 Yatırım

	measure 'İlk 10 Ülke Payı %' = ```
			VAR Ilk10 = TOPN(10, ALLSELECTED(DimUlke[UlkeTR]), [Yatırım (Milyon $)], DESC)
			RETURN DIVIDE(SUMX(Ilk10, [Yatırım (Milyon $)]), CALCULATE([Yatırım (Milyon $)], ALLSELECTED(DimUlke)))
			```
		formatString: 0.0%
		displayFolder: 1 Yatırım

	measure 'Top 10 Yatırım (Milyon $)' = ```
			VAR Sira = RANKX(ALLSELECTED(DimUlke[UlkeTR]), [Yatırım (Milyon $)], , DESC, Dense)
			RETURN IF(Sira <= 10 && [Yatırım (Milyon $)] > 0, [Yatırım (Milyon $)])
			```
		formatString: #,0
		displayFolder: 1 Yatırım

	measure 'Büyük Model Sayısı' = ```
			VAR SonYil = MAX(DimYil[Yil])
			VAR Deger = CALCULATE(SUM(FactModel[BuyukModelKumulatif]), DimYil[Yil] = SonYil)
			RETURN IF(Deger > 0, Deger)
			```
		formatString: #,0
		displayFolder: 2 Büyük modeller

	measure 'Büyük Model Üreten Ülke Sayısı' = ```
			VAR SonYil = MAX(DimYil[Yil])
			RETURN COUNTROWS(FILTER(VALUES(DimUlke[ISO3]), CALCULATE(SUM(FactModel[BuyukModelKumulatif]), DimYil[Yil] = SonYil) > 0))
			```
		formatString: 0
		displayFolder: 2 Büyük modeller

	measure 'Türkiye Yatırım (Milyon $)' = ```
			CALCULATE([Yatırım (Milyon $)], REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "TUR")
			```
		formatString: #,0.0
		displayFolder: 3 Türkiye

	measure 'Ar-Ge (% GSYH)' = ```
			MEDIAN(FactKalkinma[ArGeGsyh])
			```
		formatString: 0.00
		displayFolder: 4 Göstergeler (medyan)

	measure 'Araştırmacı (milyon kişide)' = ```
			MEDIAN(FactKalkinma[ArastirmaciMilyon])
			```
		formatString: #,0
		displayFolder: 4 Göstergeler (medyan)

	measure 'İnternet kullanımı (%)' = ```
			MEDIAN(FactKalkinma[InternetKullanim])
			```
		formatString: 0.0
		displayFolder: 4 Göstergeler (medyan)

	measure 'Genişband (100 kişide)' = ```
			MEDIAN(FactKalkinma[Genisband100])
			```
		formatString: 0.0
		displayFolder: 4 Göstergeler (medyan)

	measure 'Kişi başı GSYH ($)' = ```
			MEDIAN(FactKalkinma[KisiBasiGsyh])
			```
		formatString: #,0
		displayFolder: 4 Göstergeler (medyan)

	measure 'Yükseköğretim kayıt (%)' = ```
			MEDIAN(FactKalkinma[YuksekogretimKayit])
			```
		formatString: 0.0
		displayFolder: 4 Göstergeler (medyan)

	measure 'Türkiye: Ar-Ge (% GSYH)' = ```
			CALCULATE([Ar-Ge (% GSYH)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "TUR")
			```
		formatString: 0.00
		displayFolder: 3 Türkiye

	measure 'Dünya medyanı: Ar-Ge (% GSYH)' = ```
			CALCULATE([Ar-Ge (% GSYH)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke))
			```
		formatString: 0.00
		displayFolder: 3 Türkiye

	measure 'Türkiye: Araştırmacı (milyon kişide)' = ```
			CALCULATE([Araştırmacı (milyon kişide)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "TUR")
			```
		formatString: #,0
		displayFolder: 3 Türkiye

	measure 'Dünya medyanı: Araştırmacı (milyon kişide)' = ```
			CALCULATE([Araştırmacı (milyon kişide)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke))
			```
		formatString: #,0
		displayFolder: 3 Türkiye

	measure 'Türkiye: İnternet kullanımı (%)' = ```
			CALCULATE([İnternet kullanımı (%)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "TUR")
			```
		formatString: 0.0
		displayFolder: 3 Türkiye

	measure 'Dünya medyanı: İnternet kullanımı (%)' = ```
			CALCULATE([İnternet kullanımı (%)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke))
			```
		formatString: 0.0
		displayFolder: 3 Türkiye

	measure 'Türkiye: Genişband (100 kişide)' = ```
			CALCULATE([Genişband (100 kişide)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "TUR")
			```
		formatString: 0.0
		displayFolder: 3 Türkiye

	measure 'Dünya medyanı: Genişband (100 kişide)' = ```
			CALCULATE([Genişband (100 kişide)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke))
			```
		formatString: 0.0
		displayFolder: 3 Türkiye

	measure 'Türkiye: Kişi başı GSYH ($)' = ```
			CALCULATE([Kişi başı GSYH ($)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "TUR")
			```
		formatString: #,0
		displayFolder: 3 Türkiye

	measure 'Dünya medyanı: Kişi başı GSYH ($)' = ```
			CALCULATE([Kişi başı GSYH ($)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke))
			```
		formatString: #,0
		displayFolder: 3 Türkiye

	measure 'Türkiye: Yükseköğretim kayıt (%)' = ```
			CALCULATE([Yükseköğretim kayıt (%)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "TUR")
			```
		formatString: 0.0
		displayFolder: 3 Türkiye

	measure 'Dünya medyanı: Yükseköğretim kayıt (%)' = ```
			CALCULATE([Yükseköğretim kayıt (%)], DimYil[Yil] = 2023, REMOVEFILTERS(DimUlke))
			```
		formatString: 0.0
		displayFolder: 3 Türkiye

	measure 'Kayıtlı Yıl Nüfusu' = ```
			SUMX(CROSSJOIN(VALUES(DimUlke[ISO3]), VALUES(DimYil[Yil])), IF(CALCULATE(SUM(FactYatirim[YatirimUSD])) > 0, CALCULATE(SUM(FactKalkinma[Nufus]))))
			```
		formatString: #,0
		isHidden
		displayFolder: 5 Kişi başı

	measure 'Nüfus (Milyon, son yıl)' = ```
			VAR SonYil = MAX(DimYil[Yil])
			RETURN DIVIDE(CALCULATE(SUM(FactKalkinma[Nufus]), DimYil[Yil] = SonYil), 1000000)
			```
		formatString: #,0.0
		displayFolder: 5 Kişi başı

	measure 'Kişi Başı Yatırım ($)' = ```
			VAR Gun = CROSSJOIN(VALUES(DimUlke[ISO3]), VALUES(DimYil[Yil]))
			VAR Pay = SUMX(Gun, IF(CALCULATE(SUM(FactKalkinma[Nufus])) > 0, CALCULATE(SUM(FactYatirim[YatirimUSD]))))
			RETURN DIVIDE(Pay, [Kayıtlı Yıl Nüfusu])
			```
		formatString: #,0.00
		displayFolder: 5 Kişi başı

	measure 'Top 10 Kişi Başı Yatırım ($)' = ```
			VAR Havuz = FILTER(ALLSELECTED(DimUlke[UlkeTR]), [Nüfus (Milyon, son yıl)] >= 1)
			VAR Sira = RANKX(Havuz, [Kişi Başı Yatırım ($)], , DESC, Dense)
			RETURN IF([Nüfus (Milyon, son yıl)] >= 1 && Sira <= 10 && [Kişi Başı Yatırım ($)] > 0, [Kişi Başı Yatırım ($)])
			```
		formatString: #,0.0
		displayFolder: 5 Kişi başı

	measure 'Milyon Kişiye Büyük Model' = ```
			DIVIDE([Büyük Model Sayısı], [Nüfus (Milyon, son yıl)])
			```
		formatString: 0.00
		displayFolder: 5 Kişi başı

	measure 'Dünya Kişi Başı Yatırım ($)' = ```
			CALCULATE([Kişi Başı Yatırım ($)], REMOVEFILTERS(DimUlke))
			```
		formatString: #,0.0
		displayFolder: 5 Kişi başı

	measure 'Türkiye Kişi Başı Yatırım ($)' = ```
			CALCULATE([Kişi Başı Yatırım ($)], REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "TUR")
			```
		formatString: #,0.00
		displayFolder: 5 Kişi başı

	measure 'ABD Nüfus Payı %' = ```
			VAR SonYil = MAX(DimYil[Yil])
			RETURN DIVIDE(CALCULATE(SUM(FactKalkinma[Nufus]), REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "USA", DimYil[Yil] = SonYil), CALCULATE(SUM(FactKalkinma[Nufus]), REMOVEFILTERS(DimUlke), DimYil[Yil] = SonYil))
			```
		formatString: 0.0%
		displayFolder: 5 Kişi başı

	partition _Olcular = m
		mode: import
		source =
				let
				    Kaynak = #table(type table [Sutun = Int64.Type], {{1}})
				in
				    Kaynak
