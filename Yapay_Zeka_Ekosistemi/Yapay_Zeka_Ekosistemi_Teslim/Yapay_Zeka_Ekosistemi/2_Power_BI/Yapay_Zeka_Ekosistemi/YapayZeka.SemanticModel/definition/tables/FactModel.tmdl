table FactModel

	column ISO3
		dataType: string
		summarizeBy: none
		sourceColumn: ISO3

	column Yil
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Yil

	column BuyukModelKumulatif
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: BuyukModelKumulatif

	partition FactModel = m
		mode: import
		source =
			let
			    Ikili = Binary.Decompress(
				Binary.FromText(
					"",
				BinaryEncoding.Base64), Compression.Deflate),
			    Csv = Csv.Document(Ikili, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Baslik = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),
			    Tip = Table.TransformColumnTypes(Baslik, {
					{"ISO3", type text},
					{"Yil", Int64.Type},
					{"BuyukModelKumulatif", Int64.Type}
				}, "en-US")
			in
			    Tip
