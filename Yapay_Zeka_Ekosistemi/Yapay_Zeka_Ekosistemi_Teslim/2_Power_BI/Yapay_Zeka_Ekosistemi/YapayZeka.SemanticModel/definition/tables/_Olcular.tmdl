	measure 'Kayıtlı Yıl Nüfusu' = SUMX(CROSSJOIN(VALUES(DimUlke[ISO3]), VALUES(DimYil[Yil])), IF(CALCULATE(SUM(FactYatirim[YatirimUSD])) > 0, CALCULATE(SUM(FactKalkinma[Nufus]))))
		formatString: #,0
		isHidden
		displayFolder: 5 Kişi başı
		lineageTag: 2f00df27-7b49-4ee5-b4b6-9b1ac8085d5e

	measure 'Nüfus (Milyon, son yıl)' =
			VAR SonYil = MAX(DimYil[Yil])
			RETURN DIVIDE(CALCULATE(SUM(FactKalkinma[Nufus]), DimYil[Yil] = SonYil), 1000000)
		formatString: #,0.0
		displayFolder: 5 Kişi başı
		lineageTag: 1ce29ae0-dba8-4a25-b117-c464ad44c063

	measure 'Kişi Başı Yatırım ($)' = DIVIDE(SUM(FactYatirim[YatirimUSD]), [Kayıtlı Yıl Nüfusu])
		formatString: #,0.00
		displayFolder: 5 Kişi başı
		lineageTag: 37145957-2577-40fd-9684-1b31827d7994

	measure 'Top 10 Kişi Başı Yatırım ($)' =
			VAR Havuz = FILTER(ALLSELECTED(DimUlke[UlkeTR]), [Nüfus (Milyon, son yıl)] >= 1)
			VAR Sira = RANKX(Havuz, [Kişi Başı Yatırım ($)], , DESC, Dense)
			RETURN IF([Nüfus (Milyon, son yıl)] >= 1 && Sira <= 10 && [Kişi Başı Yatırım ($)] > 0, [Kişi Başı Yatırım ($)])
		formatString: #,0.0
		displayFolder: 5 Kişi başı
		lineageTag: 078fb94d-ac63-4ef6-88f5-440ed62300cd

	measure 'Milyon Kişiye Büyük Model' = DIVIDE([Büyük Model Sayısı], [Nüfus (Milyon, son yıl)])
		formatString: 0.00
		displayFolder: 5 Kişi başı
		lineageTag: 90198f7a-7f28-4357-929c-f6359f17cf30

	measure 'Dünya Kişi Başı Yatırım ($)' = CALCULATE([Kişi Başı Yatırım ($)], REMOVEFILTERS(DimUlke))
		formatString: #,0.0
		displayFolder: 5 Kişi başı
		lineageTag: 5f6a1490-9b43-4518-89d6-10d91414ecde

	measure 'Türkiye Kişi Başı Yatırım ($)' = CALCULATE([Kişi Başı Yatırım ($)], REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "TUR")
		formatString: #,0.00
		displayFolder: 5 Kişi başı
		lineageTag: 55565a32-373e-45b7-b33b-15d24530c1fc

	measure 'ABD Nüfus Payı %' =
			VAR SonYil = MAX(DimYil[Yil])
			RETURN DIVIDE(CALCULATE(SUM(FactKalkinma[Nufus]), REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "USA", DimYil[Yil] = SonYil), CALCULATE(SUM(FactKalkinma[Nufus]), REMOVEFILTERS(DimUlke), DimYil[Yil] = SonYil))
		formatString: 0.0%
		displayFolder: 5 Kişi başı
		lineageTag: 61f9701b-141b-4734-8661-f82f2bf7cf7e

