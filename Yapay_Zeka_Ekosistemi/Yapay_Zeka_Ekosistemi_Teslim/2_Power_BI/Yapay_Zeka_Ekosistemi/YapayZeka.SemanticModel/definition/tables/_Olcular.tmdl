table _Olcular
	lineageTag: 52fbc78c-de72-4605-a64e-71821450f322

	measure 'Yatırım (Milyon $)' = DIVIDE(SUM(FactYatirim[YatirimUSD]), 1000000)
		formatString: #,0.0
		displayFolder: 1 Yatırım
		lineageTag: b9f91d63-3598-4f9c-8a1a-597de8144810

	measure 'Toplam Yatırım (Milyar $)' = DIVIDE(SUM(FactYatirim[YatirimUSD]), 1000000000)
		formatString: #,0.0
		displayFolder: 1 Yatırım
		lineageTag: 9d7718bf-a2e3-45f8-84b3-08746599ce28

	measure 'Yatırım Alan Ülke Sayısı' = DISTINCTCOUNT(FactYatirim[ISO3])
		formatString: 0
		displayFolder: 1 Yatırım
		lineageTag: bf376d80-2ca4-4fee-9c70-f65a604ce70f

	measure 'Yatırım Kaydı Olan Ülke Oranı' = DIVIDE([Yatırım Alan Ülke Sayısı], DISTINCTCOUNT(DimUlke[ISO3]))
		formatString: 0%
		displayFolder: 1 Yatırım
		lineageTag: 98108973-387b-4d3c-85c1-a44b6446da96

	measure 'ABD Payı %' = DIVIDE(CALCULATE(SUM(FactYatirim[YatirimUSD]), REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "USA"), CALCULATE(SUM(FactYatirim[YatirimUSD]), REMOVEFILTERS(DimUlke)))
		formatString: 0.0%
		displayFolder: 1 Yatırım
		lineageTag: 706b325c-a685-4263-af42-d191b21f79c1

	measure 'İlk 10 Ülke Payı %' =
			VAR Ilk10 = TOPN(10, ALLSELECTED(DimUlke[UlkeTR]), [Yatırım (Milyon $)], DESC)
			RETURN DIVIDE(SUMX(Ilk10, [Yatırım (Milyon $)]), CALCULATE([Yatırım (Milyon $)], ALLSELECTED(DimUlke)))
		formatString: 0.0%
		displayFolder: 1 Yatırım
		lineageTag: 7ee4c402-674b-4450-af85-75b613c2bca7

	measure 'Top 10 Yatırım (Milyon $)' =
			VAR Sira = RANKX(ALLSELECTED(DimUlke[UlkeTR]), [Yatırım (Milyon $)], , DESC, Dense)
			RETURN IF(Sira <= 10 && [Yatırım (Milyon $)] > 0, [Yatırım (Milyon $)])
		formatString: #,0
		displayFolder: 1 Yatırım
		lineageTag: 58004174-3c99-467e-9f12-068d3712692c

	measure 'Büyük Model Sayısı' =
			VAR SonYil = MAX(DimYil[Yil])
			VAR Deger = CALCULATE(SUM(FactModel[BuyukModelKumulatif]), DimYil[Yil] = SonYil)
			RETURN IF(Deger > 0, Deger)
		formatString: #,0
		displayFolder: 2 Büyük modeller
		lineageTag: 1faf9371-82da-4d16-8d12-8c28fcaf146b

	measure 'Büyük Model Üreten Ülke Sayısı' =
			VAR SonYil = MAX(DimYil[Yil])
			RETURN COUNTROWS(FILTER(VALUES(DimUlke[ISO3]), CALCULATE(SUM(FactModel[BuyukModelKumulatif]), DimYil[Yil] = SonYil) > 0))
		formatString: 0
		displayFolder: 2 Büyük modeller
		lineageTag: 69ea2c4b-7f72-4818-9132-0b9736f9a81b

	measure 'Türkiye Yatırım (Milyon $)' = CALCULATE([Yatırım (Milyon $)], REMOVEFILTERS(DimUlke), DimUlke[ISO3] = "TUR")
		formatString: #,0.0
		displayFolder: 3 Türkiye
		lineageTag: ec970576-daea-4b86-bb1c-a2cd28ef57c1

	measure 'Ar-Ge (% GSYH)' = MEDIAN(FactKalkinma[ArGeGsyh])
