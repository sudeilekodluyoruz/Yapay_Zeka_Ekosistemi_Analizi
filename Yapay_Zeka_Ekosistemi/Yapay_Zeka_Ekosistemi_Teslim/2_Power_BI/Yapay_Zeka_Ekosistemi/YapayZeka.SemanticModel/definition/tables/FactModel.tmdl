table FactModel
	lineageTag: 85093a8d-e4ac-47b8-8d8f-c7411cdcf3a7

	column ISO3
		dataType: string
		lineageTag: d4e470cc-6ae8-4dea-8306-2ba78a7ec100
		summarizeBy: none
		sourceColumn: ISO3

	column Yil
		dataType: int64
		formatString: 0
		lineageTag: 47b42d3e-6faf-4c0f-a64b-637a1702454b
		summarizeBy: none
		sourceColumn: Yil

	column BuyukModelKumulatif
		dataType: int64
		formatString: #,0
		lineageTag: 7afe363b-dd42-41f8-8a6c-02ab436321ef
		summarizeBy: none
		sourceColumn: BuyukModelKumulatif

	partition FactModel = m
		mode: import
		source =
				let
				    Ikili = Binary.Decompress(
					Binary.FromText(
						"",
					BinaryEncoding.Base64), Compression.Deflate),
				    Csv = Csv.Document(Ikili, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Baslik = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),
				    Tip = Table.TransformColumnTypes(Baslik, {
						{"ISO3", type text},
						{"Yil", Int64.Type},
						{"BuyukModelKumulatif", Int64.Type}
					}, "en-US")
				in
				    Tip

